# Telegram Bot Notification Configuration
# Create a bot via @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# Get your numeric chat ID via @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
